{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AiFlow Build: qbookStudio",
      "type": "process",
      "command": "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe",
      "args": [
        "qbookStudio.sln",
        "/t:Build",
        "/p:Configuration=Release",
        "/p:Platform=x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "_aiFlow": {
        "owner": "AiFlow",
        "path": "qbookStudio.sln",
        "action": "Build"
      }
    },
    {
      "label": "AiFlow Build: amium-qbook",
      "type": "process",
      "command": "C:/Program Files/nodejs/node.exe",
      "args": [
        "node_modules/typescript/bin/tsc",
        "-p",
        "./"
      ],
      "options": {
        "cwd": "${workspaceFolder}/VScodePlugin/amium-qbook"
      },
      "_aiFlow": {
        "owner": "AiFlow",
        "path": "VScodePlugin/amium-qbook",
        "action": "Build"
      }
    },
    {
      "label": "AiFlow Build: qbook",
      "type": "process",
      "command": "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.vscode/build-qbook-and-extension.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "_aiFlow": {
        "owner": "AiFlow",
        "path": "qbook/qbook.csproj",
        "action": "Build"
      }
    }
  ]
}
