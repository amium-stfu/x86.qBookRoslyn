<Project>
  <Target Name="CopyBuildHostDlls" AfterTargets="CopyFilesToOutputDirectory" BeforeTargets="PostBuildEvent">
    <ItemGroup>
      <BuildHostFiles Include="$(PkgMicrosoft_CodeAnalysis_Workspaces_MSBuild)\contentFiles\any\any\BuildHost-netcore\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BuildHostFiles)"
          DestinationFiles="@(BuildHostFiles->'$(TargetDir)libs\BuildHost-netcore\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
